Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1/Frames1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
      Update Interval: 0
      Frame Timeout: 15
      Frames:
        All Enabled: false
        world:        { Value: true }
        table_top:    { Value: true }
        tcp:          { Value: true }
        bin_left:     { Value: true }
        bin_right:    { Value: true }
        kitting_tray: { Value: true }
        camera_link:  { Value: true }
    - Class: rviz_default_plugins/Camera
      Name: Camera
      Enabled: false
      Topic:
        Value: /camera/image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Marker
      Name: SafetyZone
      Enabled: true
      Topic:
        Value: /viz/safety_marker
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.7
      Pitch: 0.4
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Views:
    collapsed: false
