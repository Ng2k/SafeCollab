<?xml version="1.0" encoding="UTF-8"?>
<!--
  operator.sdf - camera-visible yellow operator body for the SafeCollab cell.

  PURPOSE. The overhead camera feeds perception's HSV blob detector
  (detect_human, hue 20..40 on OpenCV's 0-180 scale). Yellow RGB (1,1,0) maps to
  hue ~30, squarely inside that window.

  SHAPE. Static, no collision — a FLAT 0.35 x 0.35 x 0.08 m yellow puck.
  Perception recovers planar position by back-projecting the blob centroid onto
  one plane (perception plane_z_m == human _MARKER_Z == 0.95 m). A tall box,
  seen at the camera's ~21° off-vertical angle, would project a centroid biased
  outward (top face farther from nadir), corrupting (x, y); a flat puck barely
  does. The 0.35 footprint keeps the blob well above min_area_px=100 at hfov=1.5.

  POSE TRACKING. cell.launch.py spawns this at the path start (0.9, 0.0, 0.95);
  human_node's gz /world/empty/set_pose moves it in X/Y with the operator, held
  at the constant marker height. The full 3-D world-&gt;human_gt TF (with the
  reaching hand's z) is broadcast at 50 Hz independently.
-->
<sdf version="1.8">
  <model name="operator">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.35 0.35 0.08</size>
          </box>
        </geometry>
        <material>
          <!-- Yellow RGB (1,1,0) → OpenCV hue 30, inside detect_human's 20..40
               window (sat/val floors 100 met by bright saturated yellow). The
               emissive term keeps the body visible under dim gz lighting. -->
          <ambient>1.0 1.0 0.0 1.0</ambient>
          <diffuse>1.0 1.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.0 1.0</specular>
          <emissive>0.1 0.1 0.0 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
