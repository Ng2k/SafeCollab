<?xml version="1.0"?>
<!-- cell.xacro - SafeCollab kitting cell (Stream A). Top-level description loaded
     by robot_state_publisher and spawned with ros_gz_sim create. Holds: world
     root, table, two feeder bins (pick), a shared kitting tray (drop, co-occupied
     with the operator), a down-looking camera on /camera/image (Stream C), the
     UR5e (ur_description macro), and the gz_ros2_control plugin. -->
<robot name="safecollab_cell" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Universal Robots UR5e: real model + solved kinematics from ur_description;
       ur_simulation_gz supplies the gz_ros2_control wiring (ur_ros2_control macro). -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>

  <!-- ================= materials ================= -->
  <material name="table_mat"><color rgba="0.6 0.45 0.3 1.0"/></material>
  <material name="bin_mat">  <color rgba="0.1 0.5 0.8 1.0"/></material>
  <material name="tray_mat"> <color rgba="0.2 0.7 0.2 1.0"/></material>
  <material name="cam_mat">  <color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ================= box helper (visual+collision+inertial, centred) ================= -->
  <xacro:macro name="box_link" params="name sx sy sz mass material">
    <link name="${name}">
      <visual>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass*(sy*sy+sz*sz)/12}" ixy="0" ixz="0"
          iyy="${mass*(sx*sx+sz*sz)/12}" iyz="0"
          izz="${mass*(sx*sx+sy*sy)/12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- geometry constants -->
  <xacro:property name="table_h"  value="0.74"/>   <!-- table top height above floor -->
  <xacro:property name="table_sx" value="1.20"/>
  <!-- table depth (y): widened from 0.80 so the feeder bins sit on the robot's
       left/right flanks at a natural UR5e reach radius (~0.41 m), giving a clean
       elbow-up side pick clear of the front operator (rather than a folded
       back-over-the-shoulder reach that looked like it "stopped short"). -->
  <xacro:property name="table_sy" value="1.05"/>

  <!-- ================= world ================= -->
  <link name="world"/>

  <!-- ================= table ================= -->
  <xacro:box_link name="table" sx="${table_sx}" sy="${table_sy}" sz="${table_h}"
                  mass="50.0" material="table_mat"/>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child  link="table"/>
    <!-- box is centred, so lift it by half its height to sit on the floor -->
    <origin xyz="0 0 ${table_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- table_top : convenience frame at the working surface, all cell items hang off it -->
  <link name="table_top"/>
  <joint name="table_to_top" type="fixed">
    <parent link="table"/>
    <child  link="table_top"/>
    <origin xyz="0 0 ${table_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================= feeder bins (pick) ================= -->
  <!-- Bins flank the base forward-of-centre at world (0.15, ±0.35) — base-rel
       (0.25, ±0.35), radius ≈ 0.43 m. The forward offset is key: bins on the
       pure-side line (base-rel x ≈ 0) sit near the UR5e shoulder singularity
       (wrist over the shoulder axis), where one bin was reachable and its mirror
       was not. Forward moves both into a well-conditioned front-side reach.
       planner_node's bin targets mirror these coordinates. -->
  <xacro:box_link name="bin_left"  sx="0.15" sy="0.15" sz="0.08" mass="0.5" material="bin_mat"/>
  <joint name="top_to_bin_left" type="fixed">
    <parent link="table_top"/>
    <child  link="bin_left"/>
    <origin xyz="0.15 0.35 0.04" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="bin_right" sx="0.15" sy="0.15" sz="0.08" mass="0.5" material="bin_mat"/>
  <joint name="top_to_bin_right" type="fixed">
    <parent link="table_top"/>
    <child  link="bin_right"/>
    <origin xyz="0.15 -0.35 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ================= shared kitting tray (drop) ================= -->
  <!-- placed at the front edge, where the human operator also reaches in -->
  <xacro:box_link name="kitting_tray" sx="0.30" sy="0.40" sz="0.04" mass="0.8" material="tray_mat"/>
  <joint name="top_to_tray" type="fixed">
    <parent link="table_top"/>
    <child  link="kitting_tray"/>
    <origin xyz="0.35 0.0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ================= the arm: Universal Robots UR5e ================= -->
  <!-- Mounted on the table top toward the back. UR joint names already match
       controllers.yaml, so the arm_controller wiring is unchanged.
       force_abs_paths=true lets gz/RViz resolve UR meshes by absolute path;
       ur_ros2_control adds the <ros2_control> system block (position/velocity/
       effort on the six joints), and the gz_ros2_control plugin is declared once
       below. -->
  <xacro:property name="ur_cfg" value="$(find ur_description)/config/ur5e"/>
  <xacro:ur_robot
      name="ur5e"
      tf_prefix=""
      parent="table_top"
      joint_limits_parameters_file="${ur_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${ur_cfg}/default_kinematics.yaml"
      physical_parameters_file="${ur_cfg}/physical_parameters.yaml"
      visual_parameters_file="${ur_cfg}/visual_parameters.yaml"
      force_abs_paths="true">
    <origin xyz="-0.10 0.0 0.0" rpy="0 0 0"/>
  </xacro:ur_robot>
  <xacro:ur_ros2_control name="ur5e" tf_prefix=""/>

  <!-- ================= camera sensor (Stream C) ================= -->
  <!-- Tall mast (1.70 m) holding the overhead camera high (world z = 2.40) and
       centred (y = 0) so the FOV covers the WHOLE operator working volume
       (x 0.35..0.9, y ±0.65, z 0.82..1.10), not just the tray — a lower/narrower
       mast let the standing/approach path fall out of frame, dropping the safety
       loop to the 'lost' fail-safe. perception/geometry.cam_to_world_transform's
       defaults mirror this chain. -->
  <xacro:box_link name="camera_mast" sx="0.04" sy="0.04" sz="1.70" mass="2.0" material="cam_mat"/>
  <joint name="top_to_mast" type="fixed">
    <parent link="table_top"/>
    <child  link="camera_mast"/>
    <origin xyz="-0.55 0.0 0.85" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.10 0.05"/></geometry>
      <material name="cam_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.10 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <!-- mount the camera at the top of the mast, pitched down to view the cell.
       camera_link world pose: table_top(0,0,0.74) + top_to_mast(-0.55,0,0.85)
       + mast_to_camera(0.10,0,0.81) = (-0.45, 0, 2.40).  pitch = 1.2 rad. -->
  <joint name="mast_to_camera" type="fixed">
    <parent link="camera_mast"/>
    <child  link="camera_link"/>
    <origin xyz="0.10 0.0 0.81" rpy="0 1.2 0"/>
  </joint>

  <!-- optical frame: REP-103 camera optical convention (z forward, x right, y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- gz camera sensor, publishing on the gz topic 'camera/image'. The ROS-side
       /camera/image comes from the ros_gz_image bridge in the launch file
       (Stream G); the contract topic name is kept identical. -->
  <gazebo reference="camera_link">
    <sensor name="cell_camera" type="camera">
      <always_on>1</always_on>
      <!-- 15 Hz: ample for perception (67 ms/frame, within its ≤100 ms budget)
           and far cheaper to render than 30 Hz. In headless CI (software GL, no
           GPU) 30 Hz dragged the real-time factor low enough that the 20 Hz
           safety loop fell below the integration test's wall-clock floor. -->
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>camera/image</topic>
      <camera>
        <!-- 1.5 rad (~86°): wide enough to see the whole working volume (see the
             mast comment). perception/geometry._CAM_HFOV mirrors this value. -->
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= gz_ros2_control plugin ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find safecollab)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
