<?xml version="1.0"?>
<!-- cell.xacro - SafeCollab kitting cell (Stream A), top-level description loaded
     by robot_state_publisher (xacro Command) and spawned with ros_gz_sim create.
     Contains:
       * world root frame
       * work table
       * two feeder bins (pick locations)
       * one shared kitting tray (drop location, co-occupied with the operator)
       * a down-looking camera sensor publishing on /camera/image (for Stream C)
       * the 6-DOF arm (from arm.xacro) mounted on the table
       * the gz_ros2_control::GazeboSimROS2ControlPlugin loading controllers.yaml -->
<robot name="safecollab_cell" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find safecollab)/urdf/arm.xacro"/>

  <!-- ================= materials ================= -->
  <material name="table_mat"><color rgba="0.6 0.45 0.3 1.0"/></material>
  <material name="bin_mat">  <color rgba="0.1 0.5 0.8 1.0"/></material>
  <material name="tray_mat"> <color rgba="0.2 0.7 0.2 1.0"/></material>
  <material name="cam_mat">  <color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ================= box helper (visual+collision+inertial, centred) ================= -->
  <xacro:macro name="box_link" params="name sx sy sz mass material">
    <link name="${name}">
      <visual>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass*(sy*sy+sz*sz)/12}" ixy="0" ixz="0"
          iyy="${mass*(sx*sx+sz*sz)/12}" iyz="0"
          izz="${mass*(sx*sx+sy*sy)/12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- geometry constants -->
  <xacro:property name="table_h"  value="0.74"/>   <!-- table top height above floor -->
  <xacro:property name="table_sx" value="1.20"/>
  <xacro:property name="table_sy" value="0.80"/>

  <!-- ================= world ================= -->
  <link name="world"/>

  <!-- ================= table ================= -->
  <xacro:box_link name="table" sx="${table_sx}" sy="${table_sy}" sz="${table_h}"
                  mass="50.0" material="table_mat"/>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child  link="table"/>
    <!-- box is centred, so lift it by half its height to sit on the floor -->
    <origin xyz="0 0 ${table_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- table_top : convenience frame at the working surface, all cell items hang off it -->
  <link name="table_top"/>
  <joint name="table_to_top" type="fixed">
    <parent link="table"/>
    <child  link="table_top"/>
    <origin xyz="0 0 ${table_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================= feeder bins (pick) ================= -->
  <xacro:box_link name="bin_left"  sx="0.15" sy="0.15" sz="0.08" mass="0.5" material="bin_mat"/>
  <joint name="top_to_bin_left" type="fixed">
    <parent link="table_top"/>
    <child  link="bin_left"/>
    <origin xyz="-0.30 0.25 0.04" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="bin_right" sx="0.15" sy="0.15" sz="0.08" mass="0.5" material="bin_mat"/>
  <joint name="top_to_bin_right" type="fixed">
    <parent link="table_top"/>
    <child  link="bin_right"/>
    <origin xyz="-0.30 -0.25 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ================= shared kitting tray (drop) ================= -->
  <!-- placed at the front edge, where the human operator also reaches in -->
  <xacro:box_link name="kitting_tray" sx="0.30" sy="0.40" sz="0.04" mass="0.8" material="tray_mat"/>
  <joint name="top_to_tray" type="fixed">
    <parent link="table_top"/>
    <child  link="kitting_tray"/>
    <origin xyz="0.35 0.0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ================= the arm (mounted on the table top, centred at the back) ================= -->
  <xacro:kitting_arm parent="table_top">
    <origin xyz="-0.10 0.0 0.0" rpy="0 0 0"/>
  </xacro:kitting_arm>

  <!-- ================= camera sensor (Stream C) ================= -->
  <!-- mast rising from the table to hold the camera looking down at the cell -->
  <xacro:box_link name="camera_mast" sx="0.04" sy="0.04" sz="0.90" mass="2.0" material="cam_mat"/>
  <joint name="top_to_mast" type="fixed">
    <parent link="table_top"/>
    <child  link="camera_mast"/>
    <origin xyz="-0.55 0.35 0.45" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.10 0.05"/></geometry>
      <material name="cam_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.10 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <!-- mount the camera at the top of the mast, pitched down to view the tray/cell -->
  <joint name="mast_to_camera" type="fixed">
    <parent link="camera_mast"/>
    <child  link="camera_link"/>
    <origin xyz="0.10 0.0 0.45" rpy="0 1.0 0"/>
  </joint>

  <!-- optical frame: REP-103 camera optical convention (z forward, x right, y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- gz camera sensor; gz publishes the image on the gz topic 'camera/image'.
       The ROS-side /camera/image is provided by the ros_gz_image/bridge in the
       launch file (Stream G); the contract topic name is kept identical here. -->
  <gazebo reference="camera_link">
    <sensor name="cell_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image</topic>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= gz_ros2_control plugin (SR26_08 pattern) ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find safecollab)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
